from pathlib import Path

import pandas as pd
from snakemake.utils import Paramspace


configfile: "config/grid.yaml"
configfile: "config/animations.yaml"


cells = Paramspace(pd.DataFrame(config["cells"]))
tables = ["metrics", "events", "spectra"]


localrules:
    database,
    animation,
    animations,


rule all:
    input:
        "results/grid.duckdb",


rule train:
    output:
        **{
            table: f"results/cells/{cells.wildcard_pattern}/{table}.parquet"
            for table in tables
        },
    log:
        f"logs/train/{cells.wildcard_pattern}.log",
    benchmark:
        f"results/benchmarks/train/{cells.wildcard_pattern}.tsv"
    params:
        cell=cells.instance,
        tables=tables,
    script:
        "scripts/train.py"


rule database:
    input:
        **{
            table: expand(
                f"results/cells/{{cell}}/{table}.parquet",
                cell=cells.instance_patterns,
            )
            for table in tables
        },
    output:
        "results/grid.duckdb",
    log:
        "logs/database.log",
    params:
        tables=tables,
        cells=cells.dataframe.rename_axis("cell").reset_index(),
        fixed=config["fixed"],
    script:
        "scripts/database.py"


rule animation:
    input:
        scene="workflow/scripts/scenes.py",
        settings="config/animations.yaml",
        kernels="src/deeplearning/kernels.py",
    output:
        "results/animations/{scene}/videos/scenes/1080p60/{scene}.mp4",
    log:
        "logs/animation/{scene}.log",
    params:
        media=lambda wildcards, output: Path(output[0]).parents[3],
    shell:
        "manim render --media_dir {params.media} {input.scene} {wildcards.scene}"
        " > {log} 2>&1"


rule animations:
    input:
        expand(rules.animation.output, scene=config["animations"]),
